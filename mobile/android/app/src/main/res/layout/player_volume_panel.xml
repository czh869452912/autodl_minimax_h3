<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_volume_panel"
    android:layout_width="@dimen/player_volume_panel_width"
    android:layout_height="56dp"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="@dimen/player_volume_panel_side_margin"
    android:layout_marginBottom="@dimen/player_volume_panel_bottom_margin"
    android:background="@drawable/player_volume_panel_background"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:visibility="gone">
    <SeekBar
        android:id="@+id/player_volume_slider"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:contentDescription="@string/player_volume"
        android:max="100"
        android:progress="100"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#66FFFFFF"
        android:thumbTint="#FFFFFF" />
    <TextView
        android:id="@+id/player_volume_value"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:importantForAccessibility="no" />
</LinearLayout>
