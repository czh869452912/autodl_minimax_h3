{
  "expo": {
    "name": "AutoDL H3",
    "slug": "autodl-h3",
    "scheme": "autodlh3",
    "version": "1.4.8",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "plugins": ["expo-router", "expo-sqlite", "expo-video"],
    "android": {
      "package": "com.example.autodlh3",
      "usesCleartextTraffic": false,
      "permissions": ["INTERNET", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_DATA_SYNC", "FOREGROUND_SERVICE_MEDIA_PLAYBACK", "POST_NOTIFICATIONS"]
    }
  }
}
